# Copy to .env.production before `npm run build` — Vite bakes VITE_* values
# into the built bundle at build time, so these must be real values for
# whichever environment this build is being deployed to, not placeholders.
#
# Relative, not a hostname — CloudFront fronts both the SPA and the API on
# one origin (see infra/edd-workbench/lib/edd-workbench-stack.ts's
# distribution, /api/* behavior), so the browser's own origin already
# resolves this correctly; a real domain here would break the moment this
# gets deployed to a second environment with a different CloudFront domain.
VITE_API_BASE_URL=/api
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=replace-me
VITE_AUTH0_AUDIENCE=https://edd-workbench-api
