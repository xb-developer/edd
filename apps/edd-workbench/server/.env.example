# Local dev: `docker compose -f apps/edd-workbench/docker-compose.yml up -d`,
# `npm run migrate:edd-workbench`, then set the app role's password once —
# migrations create the role but never its password (see 004_org_memberships.sql):
#   docker exec -it edd-workbench-postgres-1 psql -U postgres -d edd_workbench \
#     -c "ALTER ROLE edd_workbench_app WITH PASSWORD 'devpassword'"
AUTH0_ISSUER_BASE_URL=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://edd-workbench-api
DATABASE_URL=postgres://edd_workbench_app:devpassword@localhost:5432/edd_workbench
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/edd_workbench
EDD_WORKBENCH_SERVER_PORT=4430
S3_ENDPOINT=http://localhost:9000
DOCUMENTS_BUCKET=edd-workbench-documents-dev
SQS_ENDPOINT=http://localhost:9324
EDD_WORKBENCH_INGEST_QUEUE_URL=http://localhost:9324/queue/edd-workbench-ingest-dev
EDD_WORKBENCH_EXPORT_QUEUE_URL=http://localhost:9324/queue/edd-workbench-export-dev
EDD_WORKBENCH_OCR_QUEUE_URL=http://localhost:9324/queue/edd-workbench-ocr-dev
EDD_WORKBENCH_OCR_SERVICE_PORT=4440
EDD_WORKBENCH_EMBEDDING_QUEUE_URL=http://localhost:9324/queue/edd-workbench-embedding-dev
# No local vLLM sandbox — a real GPU instance isn't something local dev can
# stand up. Point this at a real deployed EmbeddingService endpoint (see the
# CDK stack) to test the embedding path locally, or leave unset — the
# embedding queue consumer will just fail/retry each message until it is.
EMBEDDING_SERVICE_URL=http://embedding.edd-workbench.internal:8000
# Local dev has no real Amazon Textract sandbox — hitting a real AWS
# account's Textract API from a laptop needs real credentials/region;
# see infra/edd-workbench/lib/edd-workbench-stack.ts for how the deployed
# ocr-service task gets its IAM role instead.
AWS_REGION=eu-west-2
# No Auth0 Management API credentials needed — Organizations (and its
# invitations endpoint) turned out to be unavailable on this tenant's plan,
# so routes/orgInvites.ts just records the intended email+role in our own DB;
# see auth.ts's resolveOrgContext for how that gets matched up on login.
