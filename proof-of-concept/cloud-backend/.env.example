# Local/dev Postgres. In AWS this points at RDS instead.
DATABASE_URL=postgres://edd_cloud_backend:edd_cloud_backend_dev@localhost:5432/edd_cloud_backend

# Auth0 tenant the SPA and this backend both trust.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# The API identifier (audience) created for this backend — see docs/auth0-setup.md.
AUTH0_AUDIENCE=https://api.edd-workbench.example.com

# Machine-to-Machine application authorized for the Auth0 Management API,
# used only server-side for admin-driven org/user provisioning — see docs/auth0-setup.md.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Namespaced custom-claim URL an Auth0 Action adds to platform-admin users'
# tokens (event.user.app_metadata.platform_admin === true -> this claim).
# Must be a URL Auth0 accepts as a claim namespace; doesn't need to resolve.
AUTH0_PLATFORM_ADMIN_CLAIM=https://edd-workbench.example.com/platform_admin

PORT=4520
PUBLIC_BASE_URL=http://localhost:4520

# Skips real Auth0 login entirely - every request authenticates as a fixed
# local dev user (auto-provisioned with its own org/matter on first use).
# Only ever takes effect when NODE_ENV isn't "production", on top of this -
# never set this anywhere but your own machine.
DEV_AUTH_BYPASS=false

# Secure Document Repository (Section 3.3). "local" writes to LOCAL_STORE_ROOT
# on this machine for dev/test; "s3" talks to a real private S3 bucket and
# needs S3_BUCKET + AWS_REGION (and real AWS credentials in the environment).
DOCUMENT_STORE=local
LOCAL_STORE_ROOT=./data/repository
# Signs local-dev download URLs so they expire, mirroring a real presigned
# URL's shape. Any random string is fine for local dev; never reused for S3.
LOCAL_STORE_SIGNING_SECRET=change-me-for-local-dev-only
S3_BUCKET=
AWS_REGION=

# RAG / LLM Service (Section 3.4). Local dev stands in with Ollama running
# on this machine; production points this at the GPU-backed centralized
# service instead (same model names, or swap them there).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GENERATE_MODEL=llama3.1:8b
