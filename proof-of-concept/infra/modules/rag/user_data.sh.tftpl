#!/bin/bash
set -euxo pipefail

# Self-hosted Ollama - the RAG/LLM service (Section 3.4/8.1), running entirely
# inside our own VPC's private subnet with no inbound internet access.
# Outbound access via NAT is used only once, here, to install Ollama itself
# and pull the model weights - no document text or embeddings ever leave
# this instance; cloud-backend only ever calls IN to it (rag security group).

curl -fsSL https://ollama.com/install.sh | sh

mkdir -p /etc/systemd/system/ollama.service.d
cat > /etc/systemd/system/ollama.service.d/override.conf <<'EOF'
[Service]
Environment="OLLAMA_HOST=0.0.0.0:${ollama_port}"
EOF

systemctl daemon-reload
systemctl enable ollama
systemctl restart ollama

# Wait for the service to actually accept connections before pulling models.
for i in $(seq 1 30); do
  if curl -sf "http://localhost:${ollama_port}/api/tags" >/dev/null; then
    break
  fi
  sleep 2
done

ollama pull ${embed_model}
ollama pull ${generate_model}
