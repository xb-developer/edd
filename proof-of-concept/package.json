{
  "name": "edd-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "EDD Workbench MVP — Electron shell around a local eDisclosure document register: GUID-tagged repository, metadata extraction, Office/email document viewer, tag coding, filtering, and GUID-named export.",
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:electron": "electron .",
    "dev": "concurrently -n server,client,electron -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm run wait-and-launch\"",
    "wait-and-launch": "wait-on tcp:4420 http://localhost:5183 && npm run dev:electron",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "dev:cloud-backend": "npm run dev --workspace cloud-backend",
    "build:cloud-backend": "npm run build --workspace cloud-backend",
    "test:cloud-backend": "npm run test --workspace cloud-backend",
    "db:migrate:cloud-backend": "npm run db:migrate --workspace cloud-backend",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web"
  },
  "workspaces": [
    "server",
    "client",
    "cloud-backend",
    "web"
  ],
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^43.3.0",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "tesseract.js@7.0.0": true,
    "browser-tabs-lock@1.3.0": true
  }
}
