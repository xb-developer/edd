# Copy to .env.local (gitignored) for local dev against a running cloud-backend.
# Must include /api - every route in cloud-backend lives under that prefix
# (src/index.ts mounts the whole API router there), same as production's
# VITE_CLOUD_API_BASE_URL=.../api (web/.env.production).
VITE_CLOUD_API_BASE_URL=http://localhost:4520/api

# Same Auth0 tenant/API as cloud-backend — see cloud-backend/docs/auth0-setup.md.
# This is the SPA application created in that guide's step 4, NOT the
# Machine-to-Machine app from step 5 (that one's server-side only).
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=REPLACE_ME
VITE_AUTH0_AUDIENCE=https://api.edd-workbench.example.com

# Skips real Auth0 login entirely - must match cloud-backend's
# DEV_AUTH_BYPASS=true (cloud-backend/.env.example) or requests will just get
# rejected by the backend. Never set this anywhere but your own machine.
VITE_DEV_AUTH_BYPASS=false
